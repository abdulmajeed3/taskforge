# Copy this file to .env and fill in real values. Never commit the real .env file.
# See docs/DEPLOYMENT.md and docs/SECURITY.md for guidance on each setting.

# --- Application ---
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0
API_GLOBAL_PREFIX=api/v1
# Comma-separated list of origins allowed by CORS for the web app.
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
# docker-compose.yml provisions a `taskforge` user/db on port 5432 when run as-is.
DATABASE_URL=postgresql://postgres:password@localhost:5432/taskforge_dev?schema=public
DATABASE_URL_TEST=postgresql://postgres:password@localhost:5432/taskforge_test?schema=public

JWT_ACCESS_SECRET=replace-with-a-different-64-byte-random-hex-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-different-64-byte-random-hex-string
JWT_REFRESH_TTL=30d
REFRESH_COOKIE_NAME=taskforge_refresh_token

# --- Rate limiting ---
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# --- Email (optional; without these, emails are logged to the console in dev) ---
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TaskForge <no-reply@example.com>

# --- Frontend (apps/web) ---
VITE_API_BASE_URL=http://localhost:3000/api/v1
